{
  "name": "photos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check": "tsc --noEmit",
    "check:all": "npm run check && npm run knip && npm run lint && npm run format",
    "test": "npx playwright test",
    "build:static": "cross-env NEXT_OUTPUT=export next build",
    "deploy:static": "npm run build:static",
    "sync:photos": "node scripts/sync-photos.js",
    "optimize:web": "node scripts/optimize-web-images.js",
    "optimize:web:dry": "cross-env DRY_RUN=1 node scripts/optimize-web-images.js",
    "optimize:web:force": "cross-env FORCE=1 node scripts/optimize-web-images.js",
    "optimize:docker:build": "docker build -f scripts/Dockerfile.optimize -t photos-optimizer .",
    "optimize:docker": "docker run --rm -v %cd%/scripts/.env:/app/scripts/.env photos-optimizer",
    "optimize:docker:dry": "docker run --rm -v %cd%/scripts/.env:/app/scripts/.env -e DRY_RUN=1 photos-optimizer"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@react-spring/web": "^10.1.2",
    "classnames": "^2.5.1",
    "cobe": "^2.0.1",
    "d3-geo": "^3.1.2",
    "exiftool-vendored": "^39.3.0",
    "framer-motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-globe.gl": "^2.38.0",
    "sharp": "^0.35.5",
    "thinking-orbs": "^0.3.2",
    "three": "^0.187.0",
    "three-geojson-geometry": "^2.1.2",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "knip": "^6.45.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
